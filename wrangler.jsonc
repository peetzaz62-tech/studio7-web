// Cloudflare Worker ของเว็บ: Workers Builds รัน `npm run build` แล้ว `npx wrangler deploy` ทุกครั้งที่ push ขึ้น main
{
  "name": "rmuttstudio7-web",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // ให้ Worker จัดการทุกหน้า (ใส่ meta + เนื้อหาล่าสุด) ยกเว้นไฟล์ static ที่ส่งตรงได้เลย
    "run_worker_first": ["/*", "!/assets/*", "!/img/*"]
  },
  // KV เก็บเนื้อหาที่แก้จาก dashboard + รูปที่อัปโหลด — ไม่ต้องใส่ id: wrangler สร้างให้อัตโนมัติตอน deploy ครั้งแรก
  "kv_namespaces": [{ "binding": "SITE" }],
  "observability": { "enabled": true },
  // ไม่ลบตัวแปรที่ตั้งใน Cloudflare dashboard ตอน deploy (เช่น ADMIN_PASSWORD ถ้าตั้งเป็นแบบ Text)
  "keep_vars": true
}
